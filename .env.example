# ---- Required ----
# MongoDB Atlas (region Mumbai ap-south-1) or any replica set. Transactions REQUIRE a replica set.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_DB=vss_prod

# 32+ random characters. Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# base64 of 32 random bytes (field-level encryption of bank / Aadhaar / PAN). Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing this key makes encrypted fields unreadable — store it in the password manager AND the host's secret store.
FIELD_ENCRYPTION_KEY=

# ---- Recommended ----
# Public origin(s) of the app; mutating requests from any other Origin are rejected (CSRF). Comma separated.
APP_ORIGIN=https://erp.example.com
CRON_SECRET=                 # shared secret for /api/jobs/* (Vercel Cron sends it as a Bearer token)
LOG_LEVEL=info

# ---- Tuning (defaults shown) ----
# API_RATE_USER=300                      # requests per minute per signed-in user
# API_RATE_IP=1500                       # requests per minute per IP (a whole yard shares one office IP)
# UPSTASH_REDIS_REST_URL=                # optional: share the rate-limit counters between several server instances
# UPSTASH_REDIS_REST_TOKEN=
# SLOW_QUERY_MS=200                      # a database query slower than this is logged with its shape
# EXPORT_MAX_ROWS=200000                 # hard cap for one CSV export
# MONGO_MAX_POOL=20
# MONGO_READ_PREFERENCE=primary          # default read preference for the app
# MONGO_REPORT_READ=primary              # where report/analytics reads go; secondaryPreferred on an Atlas replica set
# MONGO_AUTO_INDEX=no                    # production: run `npm run db:indexes` at each deploy instead

# ---- Optional integrations (each has a safe fallback when unset) ----
# OTP_PROVIDER=none                      # none | console (dev) | msg91 | twilio
# OTP_API_KEY=
# File storage (photos, documents, selfies). Production can use imagekit, s3, cloudinary or mongo; the database keeps only object keys.
# STORAGE_DRIVER=imagekit                # imagekit | s3 | cloudinary | mongo | local (development/tests only)
# IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/<your id>   # ImageKit endpoint
# IMAGEKIT_PUBLIC_KEY=                   # ImageKit Public Key
# IMAGEKIT_PRIVATE_KEY=                  # ImageKit Private Key (Developer options -> API keys)
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto                         # R2: auto, AWS: ap-south-1
# S3_ENDPOINT=                           # R2/MinIO endpoint; leave empty for AWS
# S3_FORCE_PATH_STYLE=no                 # yes for MinIO
# CLOUDINARY_CLOUD=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# STORAGE_LOCAL_DIR=uploads              # local driver only
# WhatsApp: without these the daily report and payment reminders wait under Settings -> "WhatsApp messages to send" for a one-tap manual send
# WHATSAPP_PROVIDER=cloud                # cloud = WhatsApp Business Cloud API (Meta)
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
# WHATSAPP_TEMPLATE=                     # approved template whose body is exactly {{1}}; needed to message people who have not written to you in 24 h
# WHATSAPP_TEMPLATE_LANG=en
# Nightly backup (needs STORAGE_DRIVER=s3): how many days of backups to keep
# BACKUP_RETENTION_DAYS=14
# Error alerts: any URL that accepts {"text": "..."} (Slack / Discord / Teams incoming webhook), at most one message a minute
# SENTRY_DSN=                           # https://<key>@<host>/<project>: errors are also sent to Sentry / GlitchTip (no SDK, plain HTTP)
# ERROR_WEBHOOK_URL=

# ---- Development only (all refused when NODE_ENV=production) ----
# ALLOW_NO_TXN=yes                       # run against a standalone mongod without transactions
# MONGO_DNS_FALLBACK=yes                 # resolve Atlas SRV through public DNS if your ISP blocks SRV lookups

# Owner dashboard assistant (OpenRouter). Owner only; it answers from the dashboard's own numbers. Without the key the chat says it is not set up.
# OPENROUTER_API_KEY=                    # secret: set it only in the host's environment (Vercel), never in a committed file
# OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
